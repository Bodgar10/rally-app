  "scripts": {
    "build:engine": "tsup --config tsup.engine.config.ts && node -e \"const f=require('fs'),d='supabase/functions/_shared/engine.bundle';f.existsSync(d+'.d.mts')&&f.renameSync(d+'.d.mts',d+'.d.ts')\"",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "private": true
